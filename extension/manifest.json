{
  "manifest_version": 3,
  "name": "序图终端",
  "version": "2.5.0",
  "minimum_chrome_version": "135",
  "description": "说明需求、核实问卷，粘贴 JSON 执行；支持本地十步历史与离线网页快照。",
  "permissions": [
    "storage",
    "scripting",
    "userScripts"
  ],
  "host_permissions": [
    "https://plan.fpgabbs.cn/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开序图终端",
    "default_popup": "ui.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://plan.fpgabbs.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
