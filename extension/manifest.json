{
  "manifest_version": 3,
  "name": "序图终端",
  "version": "2.2.1",
  "minimum_chrome_version": "135",
  "description": "复制提示词给 AI，粘贴指令一键执行；支持本地 CLI。",
  "permissions": [
    "storage",
    "scripting",
    "userScripts",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://plan.fpgabbs.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开序图终端",
    "default_popup": "ui.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://plan.fpgabbs.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
