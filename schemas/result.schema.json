{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "protocol",
    "requestId",
    "status",
    "steps",
    "summary"
  ],
  "properties": {
    "protocol": {
      "const": "xutu.result/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "success",
        "partial_success",
        "failed",
        "partial_undo",
        "partial_redo"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "success",
              "failed",
              "skipped"
            ]
          },
          "serverVerified": {
            "type": "boolean"
          },
          "code": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "not_executed",
              "unconfirmed",
              "partially_executed"
            ]
          },
          "diagnostic": {
            "type": "object",
            "description": "失败时独立只读回读，包含latest/changedSinceRead/requestedFields或读取失败状态；可能含私密业务数据，不公开上传"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "success": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "success",
        "failed",
        "skipped"
      ]
    },
    "historySummary": {
      "type": "object",
      "description": "本机批次快照状态；recorded不是全部步骤成功；unconfirmed表示不能保证恢复",
      "properties": {
        "recorded": {
          "type": "boolean"
        },
        "historyId": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "cursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "reversibleState": {
          "enum": [
            "reversible",
            "unsupported"
          ]
        },
        "unconfirmed": {
          "type": "boolean"
        }
      }
    }
  }
}
